# Infinite AI Backrooms - Environment Configuration
# Copy this file to .env and customize the values for your environment

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================

# Base URL for Ollama API
# Default: http://localhost:11434
# Docker: http://ollama:11434
BACKROOM_OLLAMA_BASE_URL=http://localhost:11434

# Timeout for Ollama API requests (seconds)
BACKROOM_OLLAMA_TIMEOUT=10

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Directory for conversation logs
BACKROOM_LOG_DIR=conversations

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
BACKROOM_LOG_LEVEL=INFO

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable thinking display by default for compatible models
BACKROOM_ENABLE_THINKING_DEFAULT=true

# ============================================================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================================================

# Uncomment and customize these if needed
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

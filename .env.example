# Infinite Backrooms Environment Configuration
# Copy this file to .env and customize the values

# ======================
# Ollama Configuration
# ======================

# URL for Ollama API server
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Connection timeout in seconds
# Default: 120
OLLAMA_TIMEOUT=120

# Response timeout for AI generation in seconds
# Maximum time to wait for a complete response
# Default: 300 (5 minutes)
OLLAMA_RESPONSE_TIMEOUT=300

# Enable HTTPS verification for Ollama connections
# Set to "false" only if using self-signed certificates
# Default: true
OLLAMA_VERIFY_SSL=true

# ======================
# Logging Configuration
# ======================

# Directory for conversation logs
# Default: conversations
LOG_DIRECTORY=conversations

# Prefix for log files
# Files will be named: {prefix}_{date}.txt
# Default: streamlit_backroom
LOG_FILE_PREFIX=streamlit_backroom

# Log level for application logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ======================
# UI Configuration
# ======================

# Number of recent messages to show in conversation UI
# Higher values use more memory
# Default: 50
MAX_HISTORY_MESSAGES=50

# Number of recent messages to send as context to AI
# Higher values provide more context but increase token usage
# Default: 10
DEFAULT_CONTEXT_MESSAGES=10

# Default temperature for AI responses (0.0 to 2.0)
# Lower = more focused, Higher = more creative
# Default: 0.7
DEFAULT_TEMPERATURE=0.7

# Enable AI thinking display (for compatible models like deepseek-r1)
# Default: true
ENABLE_THINKING=true

# ======================
# Auto-run Configuration
# ======================

# Minimum delay between auto-run turns (seconds)
# Default: 2
AUTO_RUN_DELAY_MIN=2

# Maximum delay between auto-run turns (seconds)
# Default: 8
AUTO_RUN_DELAY_MAX=8

# Enable auto-advance by default
# Default: true
AUTO_ADVANCE_DEFAULT=true

# ======================
# Development Settings
# ======================

# Enable debug mode (shows detailed error messages)
# WARNING: May expose sensitive information in errors
# Default: false
DEBUG=false

# Note: ENABLE_PROFILING was removed in v0.1.3 (unused feature flag)

# ======================
# Security Settings
# ======================

# Maximum length for persona names (characters)
# Default: 50
MAX_PERSONA_NAME_LENGTH=50

# Maximum length for system prompts (characters)
# Default: 10000
MAX_SYSTEM_PROMPT_LENGTH=10000

# Note: ENABLE_INPUT_VALIDATION was removed in v0.1.3 (input validation is always active)

# Regex search timeout (seconds)
# Protection against ReDoS attacks
# Default: 5
REGEX_TIMEOUT=5

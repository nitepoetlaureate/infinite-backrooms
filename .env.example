# Infinite Backrooms Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# Ollama API Configuration
# ============================================================================

# Base URL for Ollama API
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Connection timeout in seconds for initial API connection
# Default: 10
OLLAMA_CONNECTION_TIMEOUT=10

# Response timeout in seconds for AI model responses
# Default: 300 (5 minutes)
OLLAMA_RESPONSE_TIMEOUT=300

# ============================================================================
# Conversation Settings
# ============================================================================

# Maximum number of messages to keep in conversation history
# Higher values use more memory but provide more context
# Default: 50
MAX_HISTORY=50

# Number of recent messages to send to AI as context
# Higher values provide more context but increase API response time
# Range: 1-25
# Default: 10
CONTEXT_MESSAGES=10

# Minimum delay in seconds between auto-generated responses
# Default: 2
RESPONSE_DELAY_MIN=2

# Maximum delay in seconds between auto-generated responses
# Default: 8
RESPONSE_DELAY_MAX=8

# Enable automatic conversation advancement
# When true, conversation continues automatically
# When false, requires manual "Next Turn" button clicks
# Values: true, false, 1, 0, yes, no
# Default: true
AUTO_ADVANCE=true

# Enable AI thinking display for compatible models
# Shows the AI's reasoning process in expandable sections
# Works best with models like deepseek-r1 that support thinking
# Values: true, false, 1, 0, yes, no
# Default: true
ENABLE_THINKING=true

# ============================================================================
# Logging Configuration
# ============================================================================

# Directory for conversation log files
# Logs are saved as daily text files
# Default: conversations
LOG_DIR=conversations

# Prefix for log filenames
# Files will be named: {LOG_FILE_PREFIX}_{YYYY-MM-DD}.txt
# Default: streamlit_backroom
LOG_FILE_PREFIX=streamlit_backroom

# ============================================================================
# Advanced Settings
# ============================================================================

# These settings are defined as constants in the code and typically don't
# need to be changed. They're listed here for reference:
#
# - DEFAULT_PERSONA_COLOR: #1f77b4 (default blue for new personas)
# - ASYNC_CLEANUP_DELAY: 0.1 seconds (delay for async resource cleanup)
# - TCP_CONNECTOR_LIMIT: 1 (concurrent connections per request)
# - DATE_FORMAT: %Y-%m-%d
# - TIME_FORMAT: %H:%M:%S

# ============================================================================
# Usage Examples
# ============================================================================

# For faster responses in development:
# OLLAMA_RESPONSE_TIMEOUT=60
# RESPONSE_DELAY_MIN=1
# RESPONSE_DELAY_MAX=3

# For longer, more thoughtful conversations:
# CONTEXT_MESSAGES=25
# RESPONSE_DELAY_MIN=5
# RESPONSE_DELAY_MAX=15

# For production with remote Ollama server:
# OLLAMA_BASE_URL=http://ollama-server.example.com:11434
# OLLAMA_CONNECTION_TIMEOUT=30
# OLLAMA_RESPONSE_TIMEOUT=600

# For testing without thinking features:
# ENABLE_THINKING=false

# ============================================================================
# Notes
# ============================================================================

# - All timeout values are in seconds
# - Boolean values accept: true/false, 1/0, yes/no (case-insensitive)
# - Changes require restarting the application to take effect
# - Invalid values will fall back to defaults with a warning
# - Empty values or missing variables use the defaults shown above

# Production Environment Configuration
# DO NOT commit this file with real values!

# ======================
# Ollama Configuration
# ======================

# CRITICAL: In production, you MUST use a hosted Ollama instance or API gateway
# Options:
# 1. Self-hosted Ollama server with public endpoint
# 2. Ollama proxy service
# 3. Switch to OpenAI/Anthropic/other hosted LLM API

# Replace with your production Ollama URL
# Examples:
# - Self-hosted: https://ollama.yourdomain.com
# - Cloud service: https://api.groq.com/openai/v1 (requires code changes)
# - Proxy service: https://your-ollama-proxy.render.com
OLLAMA_URL=https://ollama.example.com

# Connection timeout in seconds
OLLAMA_TIMEOUT=120

# Response timeout for AI generation in seconds
OLLAMA_RESPONSE_TIMEOUT=300

# Enable HTTPS verification
OLLAMA_VERIFY_SSL=true

# ======================
# Logging Configuration
# ======================

LOG_DIRECTORY=conversations
LOG_FILE_PREFIX=streamlit_backroom
LOG_LEVEL=INFO

# ======================
# UI Configuration
# ======================

MAX_HISTORY_MESSAGES=50
DEFAULT_CONTEXT_MESSAGES=10
DEFAULT_TEMPERATURE=0.7
ENABLE_THINKING=true

# ======================
# Auto-run Configuration
# ======================

AUTO_RUN_DELAY_MIN=2
AUTO_RUN_DELAY_MAX=8
AUTO_ADVANCE_DEFAULT=true

# ======================
# Security Settings
# ======================

MAX_PERSONA_NAME_LENGTH=50
MAX_SYSTEM_PROMPT_LENGTH=10000
ENABLE_INPUT_VALIDATION=true
REGEX_TIMEOUT=5

# ======================
# Production Settings
# ======================

# Set to false in production
DEBUG=false
ENABLE_PROFILING=false
